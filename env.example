# ─────────────────────────────────────────────────────────────────────────────
# Polymarket / Wallet credentials
# ─────────────────────────────────────────────────────────────────────────────

PRIVATE_KEY=0xyour_private_key_here
POLYMARKET_FUNDER_ADDRESS=0xyour_polymarket_profile_address_here
SIGNATURE_TYPE=0
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# Builder program (auto-redemption)
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
POLYGON_RPC_URL=https://polygon-rpc.com

# ─────────────────────────────────────────────────────────────────────────────
# Scanning
# ─────────────────────────────────────────────────────────────────────────────

SCAN_INTERVAL_MS=4000
TARGET_ASSETS=BTC,ETH,SOL,MATIC,DOGE,XRP

# Market type toggles
ENABLE_5M=true
ENABLE_15M=true

# Max time remaining to enter (seconds per duration)
MAX_TIME_REMAINING_5M=150
MAX_TIME_REMAINING_15M=450

# ─────────────────────────────────────────────────────────────────────────────
# Dump detection
# ─────────────────────────────────────────────────────────────────────────────

# Rolling price-history window (seconds)
DUMP_LOOKBACK_SECONDS=3

# Minimum price drop % to trigger a dump signal
DUMP_THRESHOLD_PERCENT=15

# Only enter straddle if dumped ask <= this value
DUMP_ENTRY_MIN_PRICE=0.05
DUMP_ENTRY_MAX_PRICE=0.35

# ─────────────────────────────────────────────────────────────────────────────
# Straddle entry
# ─────────────────────────────────────────────────────────────────────────────

# Target sum of Leg 1 + Leg 2 prices (lower = more conservative, absorbs fees)
SUM_TARGET=0.92

# Max seconds to wait for Leg 2 GTC fill before escalating
HEDGE_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────────────────────
# DCA (Dollar-Cost Averaging on Leg 1)
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_DCA=true
DCA_THRESHOLD_PERCENT=5
MAX_DCA_COUNT=3

# ─────────────────────────────────────────────────────────────────────────────
# Fill monitoring
# ─────────────────────────────────────────────────────────────────────────────

# Base poll interval for Leg 2 fill checks (jittered ±20%)
FILL_POLL_INTERVAL_MS=5000

# Force-buy Leg 2 at market when market closes within this many seconds
STOP_LOSS_REMAINING_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# Order execution
# ─────────────────────────────────────────────────────────────────────────────

ORDER_TYPE=FOK

# ─────────────────────────────────────────────────────────────────────────────
# Slot / compounding strategy
# ─────────────────────────────────────────────────────────────────────────────

NUM_SLOTS=5
SLOT_INITIAL_USD=10
SLOT_PROFIT_MULTIPLIER=1.2
ENABLE_COMPOUNDING=true

# ─────────────────────────────────────────────────────────────────────────────
# Mode & logging
# ─────────────────────────────────────────────────────────────────────────────

SHADOW_MODE=true
LOG_FILE_PATH=./logs/activity.log
RESOLUTION_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# API & scheduler
# ─────────────────────────────────────────────────────────────────────────────

API_PORT=3000
TRADING_START_TIME=00:00
TRADING_END_TIME=23:59
DAILY_PROFIT_TARGET=
DAILY_LOSS_LIMIT=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram alerts
# ─────────────────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
