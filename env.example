# ─────────────────────────────────────────────────────────────────────────────
# Polymarket / Wallet credentials
# ─────────────────────────────────────────────────────────────────────────────

# Your Polygon EOA private key (the signing wallet)
PRIVATE_KEY=0xyour_private_key_here

# Your Polymarket profile/funder address (where USDC lives on Polymarket)
# For EOA trading this is the same as your wallet address.
# For email/Magic login this is your Polymarket proxy wallet address.
POLYMARKET_FUNDER_ADDRESS=0xyour_polymarket_profile_address_here

# Signature type:
#   0 = EOA / MetaMask (default – use this for a raw private key)
#   1 = Magic/Email login
SIGNATURE_TYPE=0

# Polymarket L2 API credentials (generated on first run if left blank)
# After first run, copy the printed credentials here so they are reused.
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# ─────────────────────────────────────────────────────────────────────────────
# Bot behaviour
# ─────────────────────────────────────────────────────────────────────────────

# How often to scan for new markets (milliseconds)
SCAN_INTERVAL_MS=4000

# Comma-separated list of crypto assets to watch
TARGET_ASSETS=BTC,ETH,SOL,MATIC,DOGE,XRP

# Comma-separated list of market durations to watch (values Polymarket uses in titles)
# The scanner matches these strings inside market question text
MARKET_DURATIONS=5m,15m

# Primary price filter: only bet on a side if its price falls in this range
# Price is 0–1 (e.g. 0.99 = 99¢). Use decimal notation.
PRICE_RANGE_MIN=0.90
PRICE_RANGE_MAX=0.99

# Fallback rule: if a market has ≤ this many seconds left AND
# the winning side price is ≤ FALLBACK_MAX_PRICE, place the bet anyway.
FALLBACK_TIME_REMAINING_S=40
FALLBACK_MAX_PRICE=0.99

# Order type: GTC | GTD | FOK | FAK
# GTC = Good-Till-Cancelled (recommended for limit)
# FOK = Fill-Or-Kill (market order, all-or-nothing)
# FAK = Fill-And-Kill (market order, partial fills ok)
ORDER_TYPE=GTC

# ─────────────────────────────────────────────────────────────────────────────
# Early close — take-profit / stop-loss on active bets
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to enable early close. When enabled, the bot monitors the bid
# price of every held token via WebSocket and exits before market expiry.
EARLY_CLOSE_ENABLED=false

# Order type for the SELL close order.
#   FOK   = Fill-Or-Kill. If rejected, the position retries automatically on
#           the next WebSocket price update (bounded by EARLY_CLOSE_MAX_ATTEMPTS).
#   LIMIT = GTC limit sell at the trigger bid. A background poller waits for
#           fill until 5 seconds before market expiry, then cancels the order
#           and lets on-chain resolution handle the position.
EARLY_CLOSE_ORDER_TYPE=FOK

# Take profit: close when the position gains this percentage of the original stake.
# e.g. EARLY_CLOSE_TP_PERCENT=30  → close when P&L >= +30% of stake
EARLY_CLOSE_TP_PERCENT=30

# Stop loss: close when the position loses this percentage of the original stake.
# e.g. EARLY_CLOSE_SL_PERCENT=10  → close when P&L <= -10% of stake
EARLY_CLOSE_SL_PERCENT=10

# Maximum total early-close invocations per bet before giving up and letting
# the market resolve naturally. Prevents infinite retry loops when liquidity
# dries up or positions cannot be filled.
EARLY_CLOSE_MAX_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────────
# Slot / compounding strategy
# ─────────────────────────────────────────────────────────────────────────────

# Maximum number of simultaneous active bets
NUM_SLOTS=5

# Starting USDC amount per slot
SLOT_INITIAL_USD=10

# When a slot balance reaches (initial × this multiplier), extract profit and reset
SLOT_PROFIT_MULTIPLIER=1.2

# ─────────────────────────────────────────────────────────────────────────────
# Mode & logging
# ─────────────────────────────────────────────────────────────────────────────

# Set to true to simulate without placing real orders
SHADOW_MODE=true

# Path to the activity log file
LOG_FILE_PATH=./logs/activity.log

# How many milliseconds to wait between market-resolution poll attempts
RESOLUTION_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# Telegram alerts
# ─────────────────────────────────────────────────────────────────────────────

# Bot token from @BotFather. Leave blank to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=
# Chat ID to send alerts to. Use @userinfobot to find your chat ID.
TELEGRAM_CHAT_ID=

# Reset all slots to SLOT_INITIAL_USD and zero the daily P&L baseline at UTC midnight.
# Set to false to let slot balances and P&L accumulate across days without interruption.
MIDNIGHT_SLOT_RESET=true

# Send a periodic Telegram status snapshot (same format as the daily TP/SL message).
# Set to false to disable.
STATUS_SNAPSHOT_ENABLED=false
# How many hours between each snapshot (decimals allowed, e.g. 0.5 = every 30 min).
STATUS_SNAPSHOT_INTERVAL_HOURS=1
